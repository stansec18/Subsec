# Subsec API key config — copy this file to "config.env" (same folder) and
# fill in whichever keys you have. Every source here is optional: leave a
# line blank or delete it and that source is simply skipped.
#
#   cp config.env.example config.env
#
# config.env is gitignored by default so your real keys never get committed.
# CLI flags (--shodan-key etc.) and environment variables still override
# whatever is set here, in that order: CLI flag > env var > config.env.

# Shodan — https://account.shodan.io/register
SHODAN_API_KEY=

# VirusTotal — https://www.virustotal.com/gui/join-us
VT_API_KEY=

# Censys — https://search.censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# FOFA — https://fofa.info/user/register
FOFA_EMAIL=
FOFA_KEY=

# Google Custom Search JSON API — create an engine at
# https://programmablesearchengine.google.com/ (set it to search the entire
# web) and get a key at https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=
GOOGLE_CX=
